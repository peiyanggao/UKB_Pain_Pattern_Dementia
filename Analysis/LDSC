# Genetic correlation analysis using LDSC
library(GenomicSEM)

hm3_file <- "w_hm3.snplist"
ld_ref <- "eur_w_ld_chr/"

gwas_files <- c(
  "Cluster_for_munge.txt",
  "Outcome_for_munge.txt"
)

trait_names <- c("Cluster", "Outcome")

munge(
  files = gwas_files,
  hm3 = hm3_file,
  trait.names = trait_names,
  N = c(NA, NA),
  info.filter = 0.8,
  maf.filter = 0.01
)

ldsc_fit <- ldsc(
  traits = c("Cluster.sumstats.gz", "Outcome.sumstats.gz"),
  sample.prev = c(cluster_sample_prev, outcome_sample_prev),
  population.prev = c(cluster_population_prev, outcome_population_prev),
  ld = "eur_w_ld_chr/",
  wld = "eur_w_ld_chr/",
  trait.names = c("Cluster", "Outcome")
)

S <- ldsc_fit$S
rg <- S[1, 2] / sqrt(S[1, 1] * S[2, 2])

print(rg)
